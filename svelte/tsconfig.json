{
	"compilerOptions": {
		"module": "esnext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"target": "esnext",
		"types": ["vite/client"],
		"moduleResolution": "bundler",

		"isolatedModules": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"checkJs": false,

		"noImplicitAny": false,
		"strict": false,
		"sourceMap": true,

		"declaration": false,

		"paths": {
			"@types": ["./src/types"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}

{
	"name": "@garimatus/svelte-filemanager",
	"version": "0.1.0",
	"description": "A Svelte/TypeScript component for file management",
	"productTag": "filemanager",
	"productTrial": false,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:dist": "vite build --mode dist",
		"build:tests": "vite build --mode test",
		"lint": "yarn eslint ./demos ./src",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"start": "vite --open",
		"start:tests": "vite --open=/tests/ --host 0.0.0.0  --port 5100 --mode test",
		"test": "true",
		"test:cypress": "cypress run -P ./ --config \"baseUrl=http://localhost:5100/tests\""
	},
	"svelte": "src/index.ts",
	"exports": {
		".": {
			"svelte": "./src/index.ts",
			"types": "./types/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/svar-widgets/filemanager.git"
	},
	"bugs": {
		"url": "https://forum.svar.dev"
	},
	"homepage": "https://svar.dev/svelte/filemanager/",
	"dependencies": {
		"@lucide/svelte": "^1.31.0",
		"@svar-ui/filemanager-data-provider": "2.6.0",
		"@svar-ui/filemanager-locales": "2.6.0",
		"@svar-ui/filemanager-store": "2.6.0",
		"@svar-ui/lib-dom": "0.13.1",
		"@svar-ui/lib-state": "1.9.7",
		"@svar-ui/lib-svelte": "0.5.2",
		"@svar-ui/svelte-core": "2.6.0",
		"@svar-ui/svelte-grid": "2.7.0",
		"@svar-ui/svelte-menu": "2.6.0",
		"@svar-ui/svelte-uploader": "2.6.0"
	},
	"devDependencies": {
		"svelte-check": "^4.0.0"
	},
	"files": [
		"src",
		"types",
		"readme.md",
		"whatsnew.md",
		"license.txt"
	],
	"keywords": [
		"svelte",
		"file manager",
		"file-manager",
		"file-explorer",
		"file explorer",
		"file browser",
		"svelte component",
		"ui component",
		"svelte file manager",
		"svar widgets"
	]
}
